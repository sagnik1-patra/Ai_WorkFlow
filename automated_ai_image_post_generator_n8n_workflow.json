      ],
      "webhookId": "591ab235-4d81-4680-979c-3e16fa554ace"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.freepik.com/v1/ai/mystic/{{ $('HTTP Request').item.json.data.task_id || $('HTTP Request').item.json.task_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-freepik-api-key",
              "value": "YOUR_FREEPIK_API_KEY"
