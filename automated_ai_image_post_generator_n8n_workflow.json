      "typeVersion": 4.2,
      "position": [
        1090,
        260
      ]
    },
    {
      "parameters": {
        "resume": "timeInterval",
        "amount": 30,
        "unit": "seconds"
      },
      "id": "90c05ff6-5a2e-41cb-a281-c75115314318",
