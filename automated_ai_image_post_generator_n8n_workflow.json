        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "x-freepik-api-key",
              "value": "YOUR_FREEPIK_API_KEY"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParametersJson": "={{ JSON.stringify({ prompt: $json.text }) }}",
        "options": {}
      },
      "id": "f238836f-9eba-42d8-a270-2d2b05113d7b",
