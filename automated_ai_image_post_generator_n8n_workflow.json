    {
      "parameters": {
        "promptType": "define",
        "text": "=summarize this article {{ $json.newslink }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a precise article summarizer. Summarize the article clearly and factually, focusing on the most important ideas, implications, and AI-industry relevance."
            }
          ]
        }
      },
      "id": "1cffd127-832d-4467-82b6-6a098dd43cfd",
      "name": "Summarize Article",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        360,
        260
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "619ef5ba-0d63-440f-bf91-56b39ff14702",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        360,
        440
