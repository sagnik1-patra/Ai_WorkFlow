      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Assume the role of an Industry expert and create a ready-to-post LinkedIn content discussing key points from the provided news article relevant to artificial intelligence. The post should provide insightful analysis, connect with current industry trends, and encourage professional engagement. Highlight notable implications for the industry and include a professional call to action. Make the post informative, structured, under 3000 characters, and ready to copy-paste directly to LinkedIn without any modifications. Article summary: {{ $json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional LinkedIn content strategist specializing in AI and technology topics. Write clear, professional, engaging posts that are insightful and ready to publish."
            }
          ]
        }
      },
      "id": "ef7a6678-73fd-46f1-9029-d582b3e21f59",
      "name": "Create LinkedIn Post",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        600,
        260
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.6
        }
      },
      "id": "8f2e6125-31cd-41ce-80b5-4734275e10c9",
