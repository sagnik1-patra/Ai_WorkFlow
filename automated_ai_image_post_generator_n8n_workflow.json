      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        600,
        440
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a concise image prompt (max 50 words) for a LinkedIn post visual based on this AI article summary. Focus on modern, professional imagery with technology/business themes. Use clear descriptive terms suitable for AI image generation. {{ $('Summarize Article').item.json.text }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert at writing AI image prompts for professional LinkedIn visuals. Keep the prompt concise, descriptive, and visually strong."
            }
          ]
        }
      },
      "id": "2ecb243f-70a8-4d09-8af8-82bb179ef163",
      "name": "Create Image Prompt",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
