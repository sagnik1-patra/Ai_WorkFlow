    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze this article and create a summary that:\n\n1. Captures the 3 most important insights\n2. Includes any actionable advice or tips\n3. Maintains the original tone and perspective\n4. Highlights implications for the target audience\n5. Stays under 200 words for social media adaptation\n\nArticle: {{ $json.body.text || $json.text || $json.body.url || $json.url }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a social media strategist with expertise in content adaptation. Analyze the article URL/content provided and return a concise, useful summary for LinkedIn post creation."
            }
          ]
        }
      },
      "id": "256b5232-e310-48f7-8142-95a6abf53b8e",
      "name": "Generate Summary",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        380,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.3
        }
      },
      "id": "e281496f-755e-444c-abcd-901384873776",
      "name": "Gemini - Article Summarizer",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        380,
        520
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Transform this learning summary into an engaging LinkedIn post: {{ $json.text }}\n\nCreate a post that:\n- Starts with a hook about today's learning achievement\n- Shares 2-3 specific insights or skills gained\n- Includes a reflection on how this knowledge applies to real-world scenarios\n- Uses relevant hashtags: #AIBootcamp #LearningJourney #GenerativeAI #TechSkills #100DaysOfCode\n- Ends with a question to engage the community\n- Length: 200-300 words\n- Professional yet authentic tone\n- Include relevant emojis for visual appeal\n\nDirectly return only the final LinkedIn post content. Do not add any intro, labels, or markdown fences.",
        "messages": {
          "messageValues": [
            {
              "message": "You are an expert LinkedIn post creator. Turn summaries into polished, engaging LinkedIn posts that are ready to publish."
            }
          ]
        }
      },
      "id": "a6f33a7b-b76f-4405-add4-ec5b1689eed1",
      "name": "Generate LinkedIn Post Content",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
