    },
    {
      "parameters": {
        "toolDescription": "Use this tool to search Wikipedia for information about people, companies, places, concepts, definitions, and general knowledge.",
        "query": "={{ $fromAI('wikipedia_query', 'A concise Wikipedia search query for the topic, person, company, or concept') }}"
      },
      "id": "56152730-8cc3-4d21-be74-f8a083d30676",
