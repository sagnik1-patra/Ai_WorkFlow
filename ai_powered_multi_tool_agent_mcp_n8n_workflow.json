        },
        "availableTools": "create_calendar_event,delete_calendar_event,update_calendar_event,get_calendar_events,modify_calendar_event",
        "toolName": "google_calendar",
        "options": {}
      },
      "id": "bb774245-31ab-4ea1-823f-28a44e8edc32",
      "name": "Google Calendar MCP Client Tool",
      "type": "@n8n/n8n-nodes-langchain.mcpClientTool",
      "typeVersion": 1,
      "position": [
        1300,
        560
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output || $json.text || $json.response }}",
        "additionalFields": {
          "parse_mode": "HTML"
        }
      },
      "id": "54cf5dd2-6cf8-4ccd-aa83-22e05c1d7864",
