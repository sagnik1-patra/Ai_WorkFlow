            "skills": "={{ Array.isArray($json.output?.skills) ? $json.output.skills.join(', ') : ($json.output?.skills || $json.skills) }}",
            "Cover letter": "={{ $json.output['cover letter'] || $json['cover letter'] }}"
          },
