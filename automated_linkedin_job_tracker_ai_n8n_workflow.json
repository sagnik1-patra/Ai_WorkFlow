    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a professional career advisor and technical recruiter. Analyze the job posting data and extract technical skills from the job description, then generate a personalized cover letter addressing the specific requirements.\n\nExtract Technical Skills: Identify all relevant technical skills required for the position including programming languages, frameworks, tools, and both explicitly mentioned and implicitly required skills.\n\nGenerate Cover Letter: Create a compelling 250-300 word cover letter that addresses the specific company and role, references key responsibilities, shows enthusiasm for mentioned aspects, includes relevant matching skills, and uses professional yet enthusiastic tone.\n\nStructure the cover letter as: Opening (interest in role) → Middle (relevant skills/experience) → Closing (enthusiasm and next steps).\n\nReturn only valid JSON that follows the structured output schema.\n\nInput data:\nTitle: {{ $('RSS Feed LinkedIn').item.json.title }}\nLink: {{ $('RSS Feed LinkedIn').item.json.link }}\nPublished Date: {{ $('RSS Feed LinkedIn').item.json.isoDate || $('RSS Feed LinkedIn').item.json.pubDate }}\nAbout Company and job description: {{ $('RSS Feed LinkedIn').item.json.content || $('RSS Feed LinkedIn').item.json.contentSnippet || $('RSS Feed LinkedIn').item.json.description }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional career advisor and technical recruiter. Extract technical skills and generate tailored cover letters in clean structured JSON."
            }
          ]
        }
      },
      "id": "a399efa5-2ec1-4c25-9d9f-e53e0a0ab508",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        -360,
        120
      ]
    },
    {
