      "id": "013f6cfd-5c64-4aa9-b3da-30da61f9a2d9",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1320,
        560
      ]
    },
    {
      "parameters": {
        "toolDescription": "Search Amazon India product listings via ScraperAPI. Use this only when the user has buying intent. Return top matching product listings with names, prices, ratings, and links when available.",
        "method": "GET",
        "url": "https://api.scraperapi.com/",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "api_key",
              "value": "YOUR_SCRAPERAPI_KEY"
            },
            {
              "name": "url",
              "value": "={{ 'https://www.amazon.in/s?k=' + encodeURIComponent($fromAI('amazon_search_query', 'Amazon India product search query, concise keywords only')) }}"
            },
            {
              "name": "render",
              "value": "true"
            }
          ]
        },
        "options": {}
      },
      "id": "5d317f9d-10c7-437d-b3e2-6d5de8f4e637",
