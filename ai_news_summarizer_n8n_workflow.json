      "typeVersion": 1,
      "position": [
        860,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {}
      },
      "id": "28322585-e3b0-499e-bd79-a8018a3e8d49",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1100,
        480
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are an AI news summarizer handling multiple categories.\n\nUse the following aggregated RSS feed items as source data:\n{{ JSON.stringify($json.articles) }}\n\nCreate a clean, formatted daily newsletter.\n\nOrganize by category:\n\nAI NEWS\n=======\n[Top 3 AI news items]\n\nTECHNOLOGY UPDATES\n==================\n[Top 3 technology items]\n\nFor each item, include:\n- Headline\n- 2-3 sentence summary\n- Why it matters\n- Source/link if available\n\nKeep the report professional, concise, and easy to read.",
        "messages": {
          "messageValues": []
        }
      },
      "id": "3fcc6fe6-9d96-451b-861b-83402171169f",
      "name": "AI Summarization Model",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "Daily AI News Summary",
        "message": "={{ $json.text }}",
        "options": {}
      },
      "id": "e332e744-a93d-4956-bc15-7018d224feac",
      "name": "Email Sender",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1400,
        300
      ],
      "webhookId": "34a4bd98-6b36-4c39-83d0-8b21175a5261",
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
