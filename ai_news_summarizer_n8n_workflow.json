      "typeVersion": 1,
      "position": [
        360,
        400
      ]
    },
    {
      "parameters": {
        "mode": "append"
      },
      "id": "22dfc835-36f3-4d5b-88d7-d1deacfd857c",
      "name": "Data Merger",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        620,
        300
      ]
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
