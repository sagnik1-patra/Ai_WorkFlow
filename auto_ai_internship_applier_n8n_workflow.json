        "googleSheetsTriggerOAuth2Api": {
          "id": "YOUR_GOOGLE_SHEETS_CREDENTIAL_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "You are a B.Tech student applying for a software development internship. Given your name, the internship role you're applying for, and optionally your Details, experience, and skills \u2014 write a short, polite, confident and ready-to-send email introducing yourself and expressing interest in the internship opportunity. Keep the tone enthusiastic but formal. Mention that you're eager to learn and contribute, and that you're looking forward to hearing back. End the email with a thank you and your name. Use \"Dear Hiring Manager\" as the greeting. Do not include any placeholder text, brackets, or variables that need to be filled in. The email should be complete and ready to send as-is.\n\nReturn only valid JSON matching the schema.\n\nHere is your information:\nName: {{ $json['Full Name'] }}\nto: {{ $json.HiringManagerEmail }}\nInternship Role: {{ $json['Position Applied'] }}\nCompany Name: {{ $json.CompanyName }}\nDetails: {{ $json.Details }}\nExperience: {{ $json['Experience (Years)'] }}\nSkills: {{ $json.Skills }}\nJob Post URL: {{ $json.JobPostURL }}",
        "hasOutputParser": true
      },
      "id": "a670206f-14d4-42ab-a3d7-8b9ac4002f26",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-flash",
        "options": {
          "temperature": 0.4
        }
      },
      "id": "96eb1ff0-ded2-4385-9e49-2545de5d2b44",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        520,
        560
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"to\": \"hr@examplecompany.com\",\n  \"subject\": \"Application for Software Development Internship\",\n  \"body\": \"Dear Hiring Manager,\\n\\nI hope this message finds you well. My name is John Doe, and I am currently pursuing my B.Tech. I am writing to express my interest in the Software Development Internship position.\\n\\nThank you for considering my application.\\n\\nBest regards,\\nJohn Doe\"\n}"
      },
      "id": "e1d19cb8-9de6-4b43-bf5a-23d92e7d6f47",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
